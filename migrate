#!/usr/bin/env bash
set -euo pipefail

# Removes skills and agents this repo used to provide under names that have
# since been renamed, merged or moved elsewhere, then runs ./sync.
#
# ./sync only ever adds and updates, never deletes, so retired names linger
# in ~/.claude until something removes them. This script is that something.
# Safe to re-run: it only touches names on the lists below.
#
# When you retire a name, add it to the lists below (same position in both).

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLAUDE_DIR="${HOME}/.claude"
BACKUP_FILE="${HOME}/claude-backup-$(date +%Y%m%d-%H%M%S).zip"

# Retired skill directories, and what replaced each one.
OLD_SKILLS=(
    "frontend-fluxui"
    "livewire-principles"
    "conversation-to-ait"
    "ait-crafting"
    "expand-issue"
    "feature-workflow"
)
OLD_SKILLS_WHY=(
    "renamed flux-ui (April 2026)"
    "renamed modern-livewire (April 2026)"
    "merged into ait-crafting (July 2026)"
    "replaced by spec-crafting here and the ait skill (November 2026)"
    "now ait-expand-issue, installed by 'ait install-skills' (November 2026)"
    "now ait-feature-workflow, installed by 'ait install-skills' (November 2026)"
)

# Retired agent files, and what replaced each one.
OLD_AGENTS=(
    "livewire-flux-simplifier.md"
)
OLD_AGENTS_WHY=(
    "replaced by livewire-flux-reviewer.md (April 2026)"
)

# Deprecated skills: no longer shipped, but NOT deleted, because people may
# still rely on them. This script only prints a notice for each one found.
# Revisit after May 2027: move each to OLD_SKILLS, or drop it from this list.
DEPRECATED_SKILLS=(
    "i-impeccable"
    "i-shape"
    "improve"
)
DEPRECATED_SKILLS_WHY=(
    "no longer shipped here (November 2026); maintained upstream at https://github.com/pbakaus/impeccable"
    "no longer shipped here (November 2026); maintained upstream at https://github.com/pbakaus/impeccable"
    "no longer shipped here (November 2026); it was a modified copy of shadcn's improve skill"
)

echo "=========================================="
echo "  Retired skill & agent clean-up"
echo "=========================================="
echo ""

if [ ! -d "$CLAUDE_DIR" ]; then
    echo "No ~/.claude directory found. Nothing to migrate."
    exit 0
fi

for i in "${!DEPRECATED_SKILLS[@]}"; do
    if [ -d "${CLAUDE_DIR}/skills/${DEPRECATED_SKILLS[$i]}" ]; then
        echo "[Deprecated] ~/.claude/skills/${DEPRECATED_SKILLS[$i]}/: ${DEPRECATED_SKILLS_WHY[$i]}."
        echo "             Left in place; delete it yourself when you no longer need it."
    fi
done
echo ""

found_old=0
for i in "${!OLD_SKILLS[@]}"; do
    if [ -d "${CLAUDE_DIR}/skills/${OLD_SKILLS[$i]}" ]; then
        [ "$found_old" -eq 0 ] && echo "Found retired items to remove:"
        found_old=1
        echo "  ~/.claude/skills/${OLD_SKILLS[$i]}/: ${OLD_SKILLS_WHY[$i]}"
    fi
done
for i in "${!OLD_AGENTS[@]}"; do
    if [ -f "${CLAUDE_DIR}/agents/${OLD_AGENTS[$i]}" ]; then
        [ "$found_old" -eq 0 ] && echo "Found retired items to remove:"
        found_old=1
        echo "  ~/.claude/agents/${OLD_AGENTS[$i]}: ${OLD_AGENTS_WHY[$i]}"
    fi
done

if [ "$found_old" -eq 0 ]; then
    echo "No retired skill or agent names found in ~/.claude, nothing to migrate."
    echo "If you just need to sync, run: ./sync"
    exit 0
fi
echo ""

echo "*** This will DELETE the items listed above, then run ./sync ***"
echo ""
read -rp "Create a zip backup of ~/.claude/{skills,agents,commands} first? [Y/n] " backup_answer
backup_answer="${backup_answer:-y}"

if [[ "$backup_answer" =~ ^[Yy] ]]; then
    echo ""
    echo "Backing up to ${BACKUP_FILE} ..."
    (
        cd "$CLAUDE_DIR"
        dirs_to_zip=()
        [ -d skills ]   && dirs_to_zip+=(skills)
        [ -d agents ]   && dirs_to_zip+=(agents)
        [ -d commands ] && dirs_to_zip+=(commands)
        if [ ${#dirs_to_zip[@]} -gt 0 ]; then
            zip -rq "$BACKUP_FILE" "${dirs_to_zip[@]}"
        fi
    )
    echo "Done. Backup saved to ${BACKUP_FILE}"
    echo ""
fi

read -rp "Proceed with migration? [y/N] " proceed
if [[ ! "$proceed" =~ ^[Yy] ]]; then
    echo "Aborted."
    exit 0
fi

echo ""

for skill in "${OLD_SKILLS[@]}"; do
    target="${CLAUDE_DIR}/skills/${skill}"
    if [ -d "$target" ]; then
        rm -rf "$target"
        echo "Removed skills/${skill}/"
    fi
done

for agent in "${OLD_AGENTS[@]}"; do
    target="${CLAUDE_DIR}/agents/${agent}"
    if [ -f "$target" ]; then
        rm "$target"
        echo "Removed agents/${agent}"
    fi
done

echo ""

if [ ! -f "${SCRIPT_DIR}/sync.yaml" ]; then
    echo "No sync.yaml found. Copy the example first:"
    echo "  cp sync.yaml.example sync.yaml"
    echo ""
    echo "Old items have been removed. Run ./sync after setting up sync.yaml."
else
    echo "Running ./sync ..."
    echo ""
    "${SCRIPT_DIR}/sync"
fi

echo ""
echo "Migration complete. The ait and ant skills and agents come from their"
echo "own binaries: run 'ait install-skills' and 'ant install-skills'."
